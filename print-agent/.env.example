# ==============================================================================
#  print-agent — configuration
# ==============================================================================
#  Copy to .env and adjust.  This file is gitignored, never commit it.
#
#      cp .env.example .env
#
#  Every value below is a working LOCAL DEVELOPMENT default. To deploy, copy
#  this file to the restaurant computer as .env and change the lines marked
#  [PROD].
# ==============================================================================


# --- Print service -----------------------------------------------------------

# The /agent path is required: the service refuses a WebSocket upgrade on any
# other path with a 400.
#
# [PROD] must be the HTTPS/WSS address of your nginx host, for example:
#        PRINT_SERVICE_URL=wss://print.example.com/agent
PRINT_SERVICE_URL=ws://localhost:1234/agent


# --- Identity ----------------------------------------------------------------

# Which restaurant this agent prints for. Must match the "restaurantId" in the
# order payloads. [PROD] CHANGE THIS for each restaurant.
RESTAURANT_ID=restaurant-1

# Must match AGENT_TOKEN in the print service. The agent gives up rather than
# retrying if the service rejects this.
AGENT_TOKEN=development-token


# --- Printer -----------------------------------------------------------------

# mock  = print receipts to the terminal, no hardware needed (default)
# escpos = print to a real thermal printer
PRINTER_MODE=mock

# escpos only: the printer's address on the local network.
PRINTER_HOST=192.168.1.50

# escpos only: the raw printing port. 9100 on almost all thermal printers.
PRINTER_PORT=9100

# escpos only: character encoding the printer expects. GB18030 is the escpos
# library default. Non-Latin scripts need a printer that supports the encoding.
PRINTER_ENCODING=GB18030


# --- Receipts ----------------------------------------------------------------

# Currency label printed on paper. Keep it in step with CURRENCY in the print
# service so paper and Telegram receipts agree.
CURRENCY=NPR