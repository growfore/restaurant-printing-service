    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/escpos": "^2.5.5",
    "@types/node": "^22.18.0",
    "@types/ws": "^8.18.2",
    "iconv-lite": "^0.6.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
