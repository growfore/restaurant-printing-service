# ==============================================================================
#  print-service — configuration
# ==============================================================================
#  Copy to .env and adjust.  This file is gitignored, never commit it.
#
#      cp .env.example .env
#
#  Every value below is a working LOCAL DEVELOPMENT default. To deploy, copy
#  this file to the VPS as .env and change only the lines marked [PROD].
#
#  Reminder: the service binds all interfaces. On a public host keep it behind
#  nginx and allow only 22/80/443 in the firewall.
# ==============================================================================


# --- Server -------------------------------------------------------------------

# Port for HTTP and WebSocket alike. [PROD] 1234
PORT=1234


# --- Print agent authentication -----------------------------------------------

# Shared secret every agent must present when registering. [PROD] CHANGE THIS
# to a long random string. The service refuses to start if it is empty, and
# warns at startup if this default is still in use.
#
# Generate one with:  openssl rand -hex 32
AGENT_TOKEN=development-token


# --- Order endpoint authentication -------------------------------------------

# When set, POST /orders and GET /agents require:
#     Authorization: Bearer <this value>
# Empty means no check, which is fine locally. [PROD] SET THIS.
# Without it, anyone who can reach the port can place orders and print paper.
SERVICE_TOKEN=


# --- Test ordering page ------------------------------------------------------

# true  = serve the sample ordering page at GET / (local development only)
# false = nothing at that path
#
# That page is a working order form. [PROD] MUST BE false.
SERVE_TEST_WEBSITE=false


# --- Telegram notifications --------------------------------------------------

# Announce every accepted order to a Telegram chat. Both values are required;
# leave either empty and notifications are off.
#
# Create a bot with @BotFather, then find the chat id by sending your bot any
# message and running:
#     curl "https://api.telegram.org/bot<TOKEN>/getUpdates"
# and reading the "chat"."id" of the newest update.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# --- Receipts ----------------------------------------------------------------

# Currency label used in Telegram receipts. The agent has its own CURRENCY
# setting, which controls what is printed on paper — set both to the same value.
CURRENCY=NPR